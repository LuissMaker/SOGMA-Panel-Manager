<Window x:Class="SOGMAPanelManager.PanelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar panel" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F4F6"/><Setter Property="Background" Value="#30343A"/>
            <Setter Property="BorderBrush" Value="#454B54"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F4F6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D0F12" BorderBrush="#383C43" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid x:Name="EditorHost" Background="#111318">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="OverlayCanvas" Background="Transparent"
                        MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                        MouseMove="Overlay_MouseMove"
                        MouseLeftButtonUp="Overlay_MouseLeftButtonUp"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="#222428" BorderBrush="#383C43" BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Editor del panel" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PanelNameText" Margin="0,4,0,16" Foreground="#A9AFB8" TextWrapping="Wrap"/>

                    <TextBlock Text="Censura / filtro" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Arrastra sobre la imagen para crear una zona. Puedes moverla o redimensionarla desde su esquina inferior derecha."
                               Foreground="#A9AFB8" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,10"/>

                    <TextBlock Text="Efecto" Foreground="#A9AFB8"/>
                    <ComboBox x:Name="EffectCombo" SelectionChanged="EffectCombo_SelectionChanged">
                        <ComboBoxItem Content="Pixelado" IsSelected="True"/>
                        <ComboBoxItem Content="Desenfoque"/>
                        <ComboBoxItem Content="Negro"/>
                    </ComboBox>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Intensidad" Foreground="#A9AFB8"/>
                        <TextBlock x:Name="StrengthText" DockPanel.Dock="Right" Text="14"/>
                    </DockPanel>
                    <Slider x:Name="StrengthSlider" Minimum="4" Maximum="40" Value="14" TickFrequency="1"
                            ValueChanged="StrengthSlider_ValueChanged" Margin="0,0,0,12"/>

                    <TextBlock x:Name="RegionCountText" Text="0 zonas" Foreground="#A9AFB8" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="Eliminar zona" Click="DeleteRegion_Click"/>
                        <Button Content="Limpiar todo" Click="ClearRegions_Click"/>
                    </WrapPanel>

                    <Separator Background="#3A3D43" Margin="0,2,0,15"/>
                    <TextBlock Text="Nota para Premiere" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Se añade al exportar: 0025_Capa-26__[ANIMACION].png · Los emojis solo aparecen si tú los escribes." Foreground="#A9AFB8" FontSize="11" Margin="0,4,0,7"/>
                    <TextBox x:Name="PremiereNoteBox" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="#17191C" Foreground="#F3F4F6" BorderBrush="#454B54" Padding="8"/>

                    <Separator Background="#3A3D43" Margin="0,18,0,15"/>
                    <TextBlock Text="Atajos" FontWeight="SemiBold"/>
                    <TextBlock Text="Supr: eliminar zona seleccionada&#x0a;Esc: cancelar selección actual" Foreground="#A9AFB8" FontSize="11" Margin="0,5,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Click="Cancel_Click" Margin="0"/>
                        <Button Grid.Column="2" Content="Guardar cambios" Click="Save_Click" Margin="0" Background="#38465E" BorderBrush="#586D90"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
